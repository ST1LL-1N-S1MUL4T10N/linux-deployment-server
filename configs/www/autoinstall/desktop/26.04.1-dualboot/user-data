#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  source:
    id: ubuntu-desktop
    search_drivers: true
  proxy: http://apt-cacher.lds.lan:3142
  apt:
    geoip: false
  packages:
    - sssd-ldap
    - sssd-tools
    - ldap-utils
    - nfs-common
    - ca-certificates
    - wget
    - gpg
  identity:
    realname: Superuser
    hostname: ubuntu-desktop
    username: superuser
    password: "CHANGE_HASH"
  locale: en_US.UTF-8
  keyboard:
    layout: us
  interactive-sections:
    - storage

  early-commands:
    # Set proxy for installer snap daemon
    - mkdir -p /usr/local/share/ca-certificates
    - wget -Y off -qO /usr/local/share/ca-certificates/squid-ca.crt http://pxe.lds.lan/autoinstall/proxy/squid/certificates/squid-ca.crt
    - update-ca-certificates
    - mkdir -p /etc/systemd/system/snapd.service.d
    - printf "[Service]\nEnvironment=\"HTTP_PROXY=http://squid.lds.lan:3128/\" \"HTTPS_PROXY=http://squid.lds.lan:3128/\"\n" > /etc/systemd/system/snapd.service.d/snap_proxy.conf
    - systemctl daemon-reload
    - systemctl restart snapd

  late-commands:
    # --- 0. Set Target Snap Proxy (Squid Snap Cache) ---
    - mkdir -p /target/etc/systemd/system/snapd.service.d
    - printf "[Service]\nEnvironment=\"HTTP_PROXY=http://squid.lds.lan:3128/\" \"HTTPS_PROXY=http://squid.lds.lan:3128/\"\n" > /target/etc/systemd/system/snapd.service.d/snap_proxy.conf

    # --- 1. SSSD, Domain Auth & CA Certificates ---
    - mkdir -p /target/etc/sssd /target/usr/local/share/ca-certificates
    - wget -Y off -qO /target/etc/sssd/sssd.conf http://pxe.lds.lan/autoinstall/identity/sssd/sssd.conf
    - chmod 0600 /target/etc/sssd/sssd.conf && chown root:root /target/etc/sssd/sssd.conf
    - wget -Y off -qO /target/etc/idmapd.conf http://pxe.lds.lan/autoinstall/storage/gpfs/idmapd.conf
    - chmod 0644 /target/etc/idmapd.conf && chown root:root /target/etc/idmapd.conf
    - wget -Y off -qO /target/usr/local/share/ca-certificates/MPIBRCA.crt http://pxe.lds.lan/autoinstall/identity/ldap/certificates/ldap-ca.crt
    - wget -Y off -qO /target/usr/local/share/ca-certificates/squid-ca.crt http://pxe.lds.lan/autoinstall/proxy/squid/certificates/squid-ca.crt
    - chmod 0644 /target/usr/local/share/ca-certificates/*.crt && chown root:root /target/usr/local/share/ca-certificates/*.crt
    - curtin in-target -- update-ca-certificates
    - curtin in-target -- pam-auth-update --enable mkhomedir

    # --- 2. Base GPFS Mounts ---
    - mkdir -p /target/gpfs/imag /target/gpfs/scic /target/gpfs/services
    - wget -Y off -qO /tmp/fstab.nfs http://pxe.lds.lan/autoinstall/storage/gpfs/fstab
    - cat /tmp/fstab.nfs >> /target/etc/fstab && rm -f /tmp/fstab.nfs

    # --- 3. FortiClient VPN (Local DEB Install + Repo Registration)---
    - wget -Y off -qO /target/tmp/forticlient.deb http://pxe.lds.lan/autoinstall/forticlient/forticlient-latest.deb
    - curtin in-target -- apt-get install -y /tmp/forticlient.deb
    - rm -f /target/tmp/forticlient.deb
    - wget -Y off -qO /target/tmp/DEB-GPG-KEY http://pxe.lds.lan/autoinstall/forticlient/fortinet-DEB-GPG-KEY
    - curtin in-target -- gpg --dearmor -o /usr/share/keyrings/repo.fortinet.com.gpg /tmp/DEB-GPG-KEY
    - printf '%s\n' 'deb [arch=amd64 signed-by=/usr/share/keyrings/repo.fortinet.com.gpg] https://repo.fortinet.com/repo/forticlient/8.0/ubuntu/ stable non-free' > /target/etc/apt/sources.list.d/repo.fortinet.com.list
    - rm -f /target/tmp/DEB-GPG-KEY

    # --- 4. RustDesk (Local LDS Server Fetch) ---
    - wget -Y off -qO /target/tmp/rustdesk.deb http://pxe.lds.lan/autoinstall/rustdesk/rustdesk-latest.deb
    - curtin in-target -- apt-get install -y /tmp/rustdesk.deb
    - wget -Y off -qO /target/tmp/RustDesk2.toml http://pxe.lds.lan/autoinstall/rustdesk/RustDesk2.toml
    - curtin in-target -- mkdir -p /root/.config/rustdesk /etc/rustdesk /etc/skel/.config/rustdesk
    - cp /target/tmp/RustDesk2.toml /target/root/.config/rustdesk/RustDesk2.toml
    - cp /target/tmp/RustDesk2.toml /target/etc/rustdesk/RustDesk2.toml
    - cp /target/tmp/RustDesk2.toml /target/etc/skel/.config/rustdesk/RustDesk2.toml
    - mkdir -p /target/home/superuser/.config/rustdesk
    - cp /target/tmp/RustDesk2.toml /target/home/superuser/.config/rustdesk/RustDesk2.toml
    - curtin in-target -- chown -R superuser:superuser /home/superuser/.config
    - rm -f /target/tmp/rustdesk.deb /target/tmp/RustDesk2.toml

    # --- 5. Dynamic Department NFS Mounts ---
    - |
      set -eu
      cmdline=$(cat /proc/cmdline)
      case "$cmdline" in
        *";dept="*)
          department=${cmdline#*;dept=}
          department=${department%%;*}
          if [ "$department" != "base" ]; then
            wget -Y off -qO /tmp/fstab-department "http://pxe.lds.lan/autoinstall/storage/gpfs/departments/fstab.${department}"
            cat /tmp/fstab-department >> /target/etc/fstab
            rm -f /tmp/fstab-department
          fi
          ;;
      esac

    # --- 6. Hostname & /etc/hosts Fix ---
    - bash -c 'cmdline=$(cat /proc/cmdline); case "$cmdline" in *";h="*) h=${cmdline#*;h=}; h=${h%%;*}; h=${h%% *}; printf "%s\n" "$h" > /target/etc/hostname; sed -i "s/ubuntu-desktop/$h/g" /target/etc/hosts;; esac'

    # --- 7. Cleanup & Force Password Reset ---
    - rm -f /target/etc/apt/apt.conf.d/90curtin-aptproxy
    - rm -f /target/etc/systemd/system/snapd.service.d/snap_proxy.conf
    - rm -f /etc/systemd/system/snapd.service.d/snap_proxy.conf
    - rm -f /target/etc/environment.d/90proxy.conf
    - rm -f /target/usr/local/share/ca-certificates/squid-ca.crt
    - curtin in-target -- update-ca-certificates --fresh
    - curtin in-target -- chage -d 0 superuser

  updates: all
  shutdown: reboot
