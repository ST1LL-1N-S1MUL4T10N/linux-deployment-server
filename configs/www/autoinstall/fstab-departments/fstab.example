# Example only. Real files are named fstab.<dept>: bark bran hest laur prot schu shuk stem
# The matching file is appended to /etc/fstab when the department is chosen in boot.ipxe.
nfs-server.example:/export/DEPT/data /gpfs/dept-data nfs x-systemd.automount,x-systemd.idle-timeout=2m,nfsvers=4,user,exec 0 0
